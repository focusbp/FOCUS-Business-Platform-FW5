<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<style>
{literal}
body{margin:0;background:#eef2f7;color:#334155;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px;line-height:1.6}
.sample-email-card{max-width:640px;margin:40px auto;padding:26px 20px;box-sizing:border-box;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 4px 20px rgba(30,41,59,.04)}
.sample-email-card h1{margin:0 0 24px;padding-bottom:18px;border-bottom:1px solid #edf0f4;color:#1e293b;font-size:22px;font-weight:600;line-height:1.4}
.sample-email-card-details{margin:24px 0}
.sample-email-card-details dt{margin-top:18px;color:#64748b;font-size:12px;font-weight:600}
.sample-email-card-details dd{margin:5px 0 0;color:#334155;overflow-wrap:anywhere}
.sample-email-card .public-actions-main{display:flex;gap:12px;flex-wrap:wrap}
.sample-email-card .public-actions{margin-top:24px;padding-top:20px;border-top:1px solid #edf0f4}
.sample-email-card-note{margin:0 0 20px;color:#64748b;line-height:1.8}
.sample-email-card-email.public-form{display:flex;align-items:center;gap:12px;margin:0}
.sample-email-card-email-address{flex:1;min-width:0;overflow-wrap:anywhere}
.sample-email-card button,#sample_email_card_verify_form button,#sample_email_card_email_form button{padding:10px 16px;border:1px solid transparent;border-radius:6px;background:var(--fbp-framework-primary-color,#4BA3FF);color:var(--fbp-framework-primary-text-color,#fff);font:inherit;font-weight:500;line-height:1.5;cursor:pointer;transition:background-color .15s,box-shadow .15s}
.sample-email-card button:hover,#sample_email_card_verify_form button:hover,#sample_email_card_email_form button:hover{filter:brightness(.97)}
.sample-email-card button:focus-visible,#sample_email_card_verify_form button:focus-visible,#sample_email_card_email_form button:focus-visible{outline:2px solid #4BA3FF;outline-offset:3px}
.sample-email-card-email button{flex:none;padding:6px 10px;border-color:#dce3eb;background:#f8fafc;color:#475569;font-size:12px;white-space:nowrap}
#sample_email_card_verify_form,#sample_email_card_email_form{color:#334155;font:14px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.sample-email-card [role="alert"]:not(:empty){color:#b42318}
@media(max-width:680px){.sample-email-card{margin:24px 12px}.sample-email-card h1{font-size:20px}}
{/literal}
</style>
