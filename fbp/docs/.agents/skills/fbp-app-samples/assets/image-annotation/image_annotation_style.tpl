<style>{literal}
.fbp-image-annotation{--ia-ink:#293b42;--ia-accent:#326f70;box-sizing:border-box;width:100%;min-width:0;padding:28px;background:#f5f6f2;color:var(--ia-ink);font:15px/1.7 sans-serif}
.fbp-image-annotation *{box-sizing:border-box}.fbp-image-annotation [hidden]{display:none!important}
.fbp-image-annotation .ia-stage{position:relative;isolation:isolate;width:100%;background:#edf2f5}
.fbp-image-annotation .ia-image{display:block;width:100%;max-width:100%;height:auto}
.fbp-image-annotation .ia-overlay{position:absolute;inset:0;width:100%;height:100%;touch-action:none;cursor:crosshair}
.fbp-image-annotation .ia-overlay[data-tool="move"]{cursor:grab}.fbp-image-annotation .ia-overlay[data-tool="text"]{cursor:text}
.fbp-image-annotation .ia-tools{position:absolute;z-index:3;left:8px;top:8px;bottom:8px;max-height:272px;width:44px;display:grid;grid-template-rows:repeat(6,minmax(0,1fr));gap:3px;padding:4px;background:rgba(255,255,255,.95);box-shadow:0 2px 10px #23354033;border:1px solid #d6e0de;border-radius:8px}
.fbp-image-annotation .ia-tools button{display:grid;place-items:center;min-height:0;min-width:0;width:100%;height:100%;margin:0;padding:0;border:0;border-radius:4px;background:transparent;color:#46555c;line-height:1;cursor:pointer}
.fbp-image-annotation .ia-tools button:hover{background:#e8edf2}.fbp-image-annotation .ia-tools button[aria-pressed="true"]{background:#dce9fb;color:#195caa;box-shadow:inset 2px 0 #3275d5}
.fbp-image-annotation .ia-tools svg{display:block;width:23px;height:23px;fill:currentColor;pointer-events:none}
.fbp-image-annotation .ia-inline{position:absolute;z-index:4;transform:translateY(-80%);min-width:40px;min-height:1.3em;padding:2px 4px;border:1px solid #3275d5;outline:none;color:#df2929;background:#fffffff0;box-shadow:0 1px 6px #23354022;white-space:pre-wrap;overflow-wrap:anywhere;font-family:sans-serif;line-height:1.2;cursor:text}
.fbp-image-annotation .ia-help{font-size:12px;margin:8px 0}
.fbp-image-annotation .ia-actions{display:flex;justify-content:flex-end;gap:10px;align-items:center;flex-wrap:wrap;margin-top:16px}
.fbp-image-annotation .ia-actions button{min-height:42px;padding:9px 15px;border:1px solid #9db6b4;border-radius:6px;background:var(--ia-accent);color:white;font:inherit;cursor:pointer;white-space:normal}
.fbp-image-annotation button:disabled{opacity:.5;cursor:default}.fbp-image-annotation :focus-visible{outline:3px solid #c2a15a;outline-offset:3px}
.fbp-image-annotation .ia-error{padding:12px;margin-bottom:12px;color:#913b2e;background:#fff0ec;white-space:pre-wrap}.fbp-image-annotation .ia-status{color:var(--ia-accent);font-size:13px}.fbp-image-annotation .ia-status:empty{display:none}
.multi_dialog:has(.fbp-image-annotation){max-width:calc(100vw - 24px)!important}
@media(max-width:700px){
 .fbp-image-annotation{padding:18px 12px}.fbp-image-annotation .ia-tools{left:4px;top:4px;bottom:4px;width:32px;padding:2px;gap:1px}.fbp-image-annotation .ia-tools svg{width:19px;height:19px}.fbp-image-annotation .ia-actions button{flex:1 1 120px}
 .multi_dialog:has(.fbp-image-annotation){left:12px!important;width:calc(100vw - 24px)!important;min-width:0!important}.multi_dialog:has(.fbp-image-annotation) .ui-resizable-handle{display:none!important}.multi_dialog:has(.fbp-image-annotation) .multi_dialog_scroll,.multi_dialog:has(.fbp-image-annotation) .multi_dialog_contents{min-width:0;max-width:100%;box-sizing:border-box}
}
{/literal}</style>
